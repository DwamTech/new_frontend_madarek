# انسخ هذا الملف إلى .env.local
# عنوان API النظام القديم (قراءة فقط) — متغير خادم، لا يُكشف للمتصفح
MDAREK_API_BASE=https://back.mdarek.net/api
# عنوان API العام المطلوب لإرسال التعليقات من المتصفح (ليس سراً)
NEXT_PUBLIC_MDAREK_API_BASE=https://back.mdarek.net/api
# مفتاح Cloudflare Turnstile العام فقط — لا تضع المفتاح السري هنا
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# مهلة النداء بالمللي ثانية (اختياري)
# MDAREK_API_TIMEOUT_MS=10000
# عمر التخزين المؤقت بالثواني (اختياري، الافتراضي 1800 = 30 دقيقة)
# MDAREK_API_REVALIDATE_S=1800

# عنوان الموقع العام (للـ sitemap وOG) — عدّله عند النشر
SITE_URL=https://mdarek.net

# النشرة البريدية عبر Resend (resend.com) — بدونهما يبقى نموذج الاشتراك معطَّلًا بأمان
# مفتاح API من: Resend Dashboard > API Keys
RESEND_API_KEY=
# معرّف الـ segment (لا الـ audience) من: Resend Dashboard > Audience > Segments > "..." > Copy ID
RESEND_SEGMENT_ID=
